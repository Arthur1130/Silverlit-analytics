# --- Serveur ---
PORT=4000
# Origine du front autorisée pour CORS (Vite en dev)
FRONTEND_URL=http://localhost:5173

# --- Base de données Postgres ---
# Format : postgres://user:password@host:port/database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/silverlit_analytics

# --- Authentification ---
# Secret de signature des JWT — générer une valeur longue et aléatoire :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=changez-moi-par-une-valeur-aleatoire-longue
# Durée de validité d'une session (ex : 12h, 7d)
JWT_EXPIRES_IN=12h

# --- Compte administrateur initial (créé par `npm run migrate`) ---
SEED_ADMIN_PSEUDO=arthur1130
SEED_ADMIN_PASSWORD=arthur1234
SEED_ADMIN_EMAIL=arthur1130@silverlit.fr
SEED_ADMIN_NAME=Arthur Leroy Sahli

# --- Emails (Resend) ---
# Clé API : https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Expéditeur — doit appartenir à un domaine vérifié dans Resend
EMAIL_FROM=Silverlit Analytics <invitations@votre-domaine.fr>
# Validité d'un lien d'invitation (en heures)
INVITATION_TTL_HOURS=120
